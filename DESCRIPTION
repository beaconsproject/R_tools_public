Package: bpRfunctions
Title: BEACONs R Tools for Conservation Planning
Version: 0.1.0
Authors@R: c(
    person("Melina", "Houle", email = "houle.melina@gmail.com", role = c("aut", "cre")),
    person("Pierre", "Vernier", role = "aut"),
    person("Marc", "Edwards", role = "aut"),
